--- !u!114 &8116053454523537836
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1926056749503639539}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5aaae571475bcd428016c2e8ef4568a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcOrder: {fileID: 4565515312486299703}
  npcMovement: {fileID: 3525728755951990675}
  chatBubblePrefab: {fileID: 861604141854158598, guid: 9a05d4354c59f944f9a57bfa72655404, type: 3}
  chatBubbleSpawnPoint: {fileID: 9077094529236986459}
  autoClearAfter: 5
  customDialogues:
  - dishName: Adobong Puti
    requestLines:
    - "Pahingi nga ng adobo na simple lang, \u2018yung walang toyo ha. Tsaka isang
      kanin nga po."
    - "Gusto ko \u2018yung adobo na maputi, maasim pero malinis ang lasa at pa-rice
      nga isa lang."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
  - dishName: Adobong sa Gata
    requestLines:
    - Adobo nga na may gata at konting anghang, pang Bicol style! Pahingi rin pong
      kanin!
    - "Gusto ko \u2018yung adobo na creamy at maanghang, may lasa ng niyog. Isang
      rice na rin po."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
  - dishName: Sinigang sa Sampalok
    requestLines:
    - Yung sinigang na asim na asim, yung classic lang at pa-rice nga isa lang.
    - "Pa-sinigang nga \u2018yung parang galing pa sa bakuran na sampalok. Tapos
      isang platong mainit na kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
  - dishName: Sinigang sa Mangga
    requestLines:
    - "Gusto ko \u2018yung sinigang na asim-fruity, parang hilaw na mangga tapos
      isang kanin nga po."
    - "\u2018Yung sinigang na kakaiba, may lasa ng hilaw na prutas. Pahingi rin pong
      kanin."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
  - dishName: Panciit Cantont
    requestLines:
    - "Gusto ko \u2018yung pancit na lutong wok, amoy toyo agad."
    - Pancit na may toyo at gulay, parang pang hapunan.
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
