  chatBubblePrefab: {fileID: 861604141854158598, guid: 9a05d4354c59f944f9a57bfa72655404, type: 3}
  chatBubbleSpawnPoint: {fileID: 1639728488320555459, guid: 54cd5c470db46a340a70fb80bd6f062a, type: 3}
  autoClearAfter: 2
  customDialogues:
  - dishName: Adobong Bisaya
    requestLines:
    - "Pa-adobo nga \u2018yung piniprito pa pagkatapos lutuin, \u2018yung may konting
      lutong. One rice din po.\r\n"
    - "Gusto ko \u2018yung adobo na medyo crispy, parang pang biyahe. One rice din
      po."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Sinigang sa Sampalok
    requestLines:
    - "\u2018Yung sinigang na asim na asim, \u2018yung classic lang at pa-rice nga
      isa lang."
    - "Pa-sinigang nga \u2018yung parang galing pa sa bakuran na sampalok. Tapos
      isang platong mainit na kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Kilinaw na Kambing
    requestLines:
    - "Gusto ko \u2018yung kilawin na may suka at sibuyas, \u2018yung pang-inuman.
      Isang kanin din po."
    - "Pa-kilawin nga, \u2018yung may amoy kambing pero sarap! Tapos isa ngang kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Traditional Karekare
    requestLines:
    - "Kare-Kare nga, \u2018yung may peanut sauce at bagoong sa gilid. Pa-rice din
      isa."
    - "Gusto ko \u2018yung kare-kare na pang handaan, may laman. Tapos isang kanin
      na muna."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Seafood Karekare
    requestLines:
    - "Kare-Kare nga pero \u2018wag baboy, gusto ko \u2018yung may hipon. Isang kanin
      din po."
    - "Pa-kare-kare nga \u2018yung galing dagat ang laman. Tapos isang cup ng rice."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Vegetable Karekare
    requestLines:
    - "Kare-Kare nga \u2018yung puro gulay lang, simple lang gusto ko. Isang kanin
      din po."
    - "Gusto ko \u2018yung kare-kare na walang karne, healthy lang. Tapos isang kanin
      na muna."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines: []
  - dishName: Squid Sisig
    requestLines:
    - "Sisig nga \u2018yung medyo chewy, lasang dagat. Tapos isang cup ng rice."
    - "Gusto ko \u2018yung sisig na may pusit, \u2018yung kakaiba. Isang kanin din
      po."
