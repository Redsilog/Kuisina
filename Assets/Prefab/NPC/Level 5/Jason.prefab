    midComboLines: []
  - dishName: Pork Sisig
    requestLines:
    - "Pa-sisig nga \u2018yung sizzling at medyo maanghang. Tapos isang kanin na
      muna."
    - "Gusto ko \u2018yung sisig na may calamansi sa ibabaw. Tapos pa-rice isa lang.\r\n"
