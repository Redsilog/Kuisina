  npcOrder: {fileID: 4678029363476456500}
  npcMovement: {fileID: 3150818223207602429}
  chatBubblePrefab: {fileID: 861604141854158598, guid: 9a05d4354c59f944f9a57bfa72655404, type: 3}
  chatBubbleSpawnPoint: {fileID: 1639728488320555459}
  autoClearAfter: 5
  customDialogues:
  - dishName: Adobong Puti
    requestLines:
    - "Pahingi nga ng adobo na simple lang, \u2018yung walang toyo ha. Tsaka isang
      kanin nga po."
    - "Gusto ko \u2018yung adobo na maputi, maasim pero malinis ang lasa at pa-rice
      nga isa lang."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: Adobo sa Gata
    requestLines:
    - Adobo nga na may gata at konting anghang, pang Bicol style! Pahingi rin pong
      kanin!
    - "Gusto ko \u2018yung adobo na creamy at maanghang, may lasa ng niyog. Isang
      rice na rin po."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: Sinigang sa Sampalok
    requestLines:
    - "\u2018Yung sinigang na asim na asim, \u2018yung classic lang at pa-rice nga
      isa lang."
    - "Pa-sinigang nga \u2018yung parang galing pa sa bakuran na sampalok. Tapos
      isang platong mainit na kanin!"
