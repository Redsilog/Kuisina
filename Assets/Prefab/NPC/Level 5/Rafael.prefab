--- !u!114 &-2240061318032004275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2111230945047006159}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5aaae571475bcd428016c2e8ef4568a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcOrder: {fileID: 2450847243068917007}
  npcMovement: {fileID: 7490449047604490425}
  chatBubblePrefab: {fileID: 861604141854158598, guid: 9a05d4354c59f944f9a57bfa72655404, type: 3}
  chatBubbleSpawnPoint: {fileID: 4665269520933724169}
  autoClearAfter: 5
  customDialogues:
  - dishName: Adobong Puti
    requestLines:
    - "Pahingi nga ng adobo na simple lang, \u2018yung walang toyo ha. Tsaka isang
      kanin nga po."
    - "Gusto ko \u2018yung adobo na maputi, maasim pero malinis ang lasa at pa-rice
      nga isa lang."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: Adobo sa Gata
    requestLines:
    - Adobo nga na may gata at konting anghang, pang Bicol style! Pahingi rin pong
      kanin!
    - "Gusto ko \u2018yung adobo na creamy at maanghang, may lasa ng niyog. Isang
      rice na rin po."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: ' Sinigang sa Sampalok'
    requestLines:
    - "\u2018Yung sinigang na asim na asim, \u2018yung classic lang at pa-rice nga
      isa lang."
    - "Pa-sinigang nga \u2018yung parang galing pa sa bakuran na sampalok. Tapos
      isang platong mainit na kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: Pancit Malabon
    requestLines:
    - "Pancit nga \u2018yung may seafood at kulay kahel na sauce."
    - "Gusto ko \u2018yung pancit na amoy dagat, may hipon at sabaw ng pusit."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isang kanin nga po.
    - Pahingi pong kanin.
  - dishName: Lechon Cebu
    requestLines:
    - "Pa-lechon nga \u2018yung walang sauce pero lasang-lasa pa rin. Tapos isang
      cup ng rice."
    - "Gusto ko \u2018yung lechon na ma-herbs sa loob, parang Cebu style. Pahingi
      rin pong kanin."
