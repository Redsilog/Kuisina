  npcOrder: {fileID: 4033324540559785009}
  npcMovement: {fileID: 1442535647112417804}
  chatBubblePrefab: {fileID: 861604141854158598, guid: 9a05d4354c59f944f9a57bfa72655404, type: 3}
  chatBubbleSpawnPoint: {fileID: 5695465187731649724}
  autoClearAfter: 5
  customDialogues:
  - dishName: Sinigang sa Kamias
    requestLines:
    - "Gusto ko \u2018yung sinigang na mas maasim kaysa usua tsaka isang kanin nga
      po. "
    - "\u2018Yung sinigang na parang may prutas galing puno, alam mo na. Tapos isang
      platong mainit na kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isa ngang kanin.
    - Isang kanin nga po.
    - Pahingi pong kanin.
    - Pa-rice nga isa lang.
  - dishName: Sinigang sa Sampalok
    requestLines:
    - Yung sinigang na asim na asim, yung classic lang at pa-rice nga isa lang.
    - "Pa-sinigang nga \u2018yung parang galing pa sa bakuran na sampalok. Tapos
      isang platong mainit na kanin!"
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - Isa ngang kanin.
    - Isang kanin nga po.
    - Pahingi pong kanin.
    - Pa-rice nga isa lang.
  - dishName: Sinigang sa Mangga
    requestLines:
    - "Gusto ko \u2018yung sinigang na asim-fruity, parang hilaw na mangga tapos
      isang kanin nga po."
    - "\u2018Yung sinigang na kakaiba, may lasa ng hilaw na prutas. Pahingi rin pong
      kanin."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
    - "Teka, iba \u2018to ah."
    - "Uy, parang kulang \u2018yung order ko."
    - "Hmm, baka napagpalit lang \u2018yan?"
    thankLines:
    - Salamat ha!
    - Thank you po!
    - Ay, salamat po!
    - Salamat, ang bilis mo ah!
    - Thank you, sarap nito!
    midComboLines:
    - 
    - 
    - 
    - 
  - dishName: Pancit Malabon
    requestLines:
    - "Pancit nga \u2018yung may seafood at kulay kahel na sauce"
    - "Gusto ko \u2018yung pancit na amoy dagat, may hipon at sabaw ng pusit."
    wrongLines:
    - "Ay, parang mali yata \u2018to ah."
    - "Luh, hindi ito \u2018yung inorder ko."
