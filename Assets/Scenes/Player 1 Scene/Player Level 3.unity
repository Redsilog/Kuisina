--- !u!114 &503192802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 503192800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8aa9ceb46c23bc046ae008ae49a63c9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stove
  recipes:
  - dishName: Adobong Puti
    description: Adobong Puti galing Ilocos! Walang toyo kasi limited ang trade noon
    requiredIngredients:
    - raw chicken
    - vinegar
    - chopped garlic
    - bay leaf
    - salt
    cookedDishPrefab: {fileID: 4749921419878231217, guid: ed465a5f5ececea4f9b0c3d362b60b0f, type: 3}
  - dishName: Adobong Bisaya
    description: Adobong Bisaya galing Cebu! Piniprito pa para tumagal sa mainit
      na panahon.
    requiredIngredients:
    - pork
    - vinegar
    - soy sauce
    - chopped garlic
    - pepper
    cookedDishPrefab: {fileID: 3812840457618248889, guid: 99001aafa2e9d2448ab0e575ca3f647e, type: 3}
  - dishName: Adobo sa Pula
    description: "Adobo sa Pula galing Batangas! Pula dahil sa atsuete, Batangue\xF1o
      style!"
    requiredIngredients:
    - pork
    - soy sauce
    - vinegar
    - chopped garlic
    - annatto sauce
    cookedDishPrefab: {fileID: 424874754770490518, guid: 134012646f15bcb4985da1460a36d3ac, type: 3}
  - dishName: Adobo sa Gata
    description: 
    requiredIngredients:
    - pork
    - coconut milk
    - soy sauce
    - vinegar
    - chili
    cookedDishPrefab: {fileID: 1251174177080548761, guid: d668924be0cb221439a17b24fc2ade62, type: 3}
  - dishName: Sinigang sa Sampalok
    description: Sinigang sa Sampalok galing Luzon! May sampalok sa bakuran, free
      na!
    requiredIngredients:
    - pork
    - tamarind
    - sliced tomato
    - chopped onion
    - kangkong
    cookedDishPrefab: {fileID: 6450572241212895298, guid: cb733e7f74a564e4886ba06253deb458, type: 3}
  - dishName: Sinigang sa Kamias
    description: Sinigang sa Kamias galing Batangas! Mas maasim pa sa sampalok 'to!
    requiredIngredients:
    - sliced bangus
    - kamias sliced
    - sliced tomato
    - chopped onion
    - kangkong
    cookedDishPrefab: {fileID: 1565593403924046379, guid: 7dd9a9c555dd7c44a8db290013dc6f6a, type: 3}
  - dishName: Sinigang sa Bayabas
    description: Sinigang sa Bayabas galing Central Luzon! May tamis, pambata-friendly!
    requiredIngredients:
    - sliced bangus
    - guava
    - sliced tomato
    - chopped onion
    - sliced mustard leaves
    cookedDishPrefab: {fileID: 6759702254672916274, guid: a9c7c051cfc13c340bbc07eb02be8bba, type: 3}
  - dishName: Sinigang sa Mangga
    description: Sinigang sa Mangga galing Visayas! Hilaw na mangga, perfect sa sabaw!
    requiredIngredients:
    - pork
    - sliced green mango
    - sliced tomato
    - chopped onion
    - sliced mustard leaves
