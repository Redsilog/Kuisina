  m_Name: 
  m_EditorClassIdentifier: 
  recipes:
  - dishName: Pancit Malabon
    description: Pancit Malabon! Fishing city kasi, puro seafood ang toppings!
    requiredIngredients:
    - Thick rice noodles
    - Shrimp
    - Squid
    - Mussels
    - Annatto sauce
    cookedDishPrefab: {fileID: 3336605299608830592, guid: 214272aaa4c95fe4d884e56797ea7cde, type: 3}
  - dishName: Pancit Habhab
    description: Pancit Habhab galing Lucban! Kain sa dahon, walang plato, fiesta
      style!
    requiredIngredients:
    - Miki noodles
    - Pork
    - Shrimp
    - Vinegar
    - pechay
    cookedDishPrefab: {fileID: 1512458914046312837, guid: eaa644229b526c34ba92116e3a6651f9, type: 3}
  - dishName: Pancit Canton
    description: Pancit Canton! Chinese traders dala 'to, naging Pinoy na rin!
    requiredIngredients:
    - Egg noodles
    - Pork
    - Shrimp
    - Soy sauce
    - pechay
    cookedDishPrefab: {fileID: 4794482946225722980, guid: 1465b46eefa8d7549a068944c9ea1b09, type: 3}
  - dishName: Kinilaw na Isda
    description: Kinilaw na Isda galing Visayas! Bagong huli, suka lang, walang luto!
    requiredIngredients:
    - tanigue sliced
    - calamansi
    - chopped onion
    - chili
    - ginger
    cookedDishPrefab: {fileID: 6664840034517157514, guid: aafd78afab54d224dbbb3b5d9c08c3d8, type: 3}
  - dishName: Kinilaw na Kambing
    description: Kilawin na Kambing galing Ilocos! Kambing kasi walang dagat, suka
      naman marami!
    requiredIngredients:
    - goat meat
    - vinegar
    - chopped onion
    - chopped garlic
    - ginger
    cookedDishPrefab: {fileID: 1965620761376922558, guid: 45f08eea1beeaaf4e97cbc84248cf510, type: 3}
  - dishName: Kinilaw na may Gata
    description: Kinilaw na may Gata galing Mindanao! Coconut belt eh, may gata pa!
    requiredIngredients:
    - tanigue sliced
    - vinegar
    - coconut milk
    - chili
    - ginger
    cookedDishPrefab: {fileID: 7471765686567236948, guid: b07f9b4e25c2b054b8e4520295b0b4f4, type: 3}
  - dishName: Pork Sisig
    description: Pork Sisig galing Pampanga! galing US base pig heads, naging legit
      na ulam!
    requiredIngredients:
    - pork
    - chopped onion
    - calamansi
    - chili
    cookedDishPrefab: {fileID: 1575714879232823158, guid: 60e9f6ef28c72fb439717142e821cffe, type: 3}
  - dishName: Bangus Sisig
    description: Bangus Sisig galing Dagupan! Bangus capital kasi, syempre may sisig!
    requiredIngredients:
    - bangus
    - chopped onion
    - calamansi
    - chili
    cookedDishPrefab: {fileID: 2801310890732738640, guid: 132f55829b7352244bffeefb381e7d00, type: 3}
  - dishName: Squid Sisig
    description: Squid Sisig galing coastal areas! Pusit version, pang-bar favorite!
    requiredIngredients:
    - Squid
    - chopped onion
    - calamansi
    - chili
    cookedDishPrefab: {fileID: 2060069828839427841, guid: 7bf88337495987a45a46046f04e298e4, type: 3}
  - dishName: Laing
    description: Laing galing Bicol! Tuyo na dahon, maanghang na gata, perfect combo!
    requiredIngredients:
    - Dried taro leaves
    - coconut milk
    - bagoong
    - chili
    cookedDishPrefab: {fileID: 2227652599799674470, guid: c0d19d94da616314ea7503d1042c1591, type: 3}
  - dishName: Pinangat na Gabi
    description: Pinangat galing Bicol! Fresh na dahon, may laman sa loob, surprise!
    requiredIngredients:
    - shrimp
    - bagoong
    - coconut milk
    cookedDishPrefab: {fileID: 1011776673750389983, guid: 5b22278b80f7830428dd60e9aa20c49c, type: 3}
